fn to_string(list) {
    let mut list_str = "[";
    let mut cur_node = list.start_node;
    while (cur_node != nil)  {
        list_str = list_str + str(cur_node.data) + "; ";
        cur_node = cur_node.next_node;
    }

    return list_str + "]";
}



